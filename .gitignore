# ====================================
# MyTodoWebApplication_on_AWS
# .gitignore Configuration
# ====================================

# ====================================
# 1. OS固有ファイル
# ====================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.nfs*

# ====================================
# 2. エディタ・IDE設定
# ====================================

# Visual Studio Code
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json

# JetBrains IDEs
.idea/
*.iml
*.iws

# Eclipse
.classpath
.project
.settings/

# Vim
[._]*.s[a-w][a-z]
*.un~
Session.vim
.netrwhist

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# ====================================
# 3. 言語・フレームワーク固有
# ====================================

# Go
*.exe
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum
backend/bin/

# Node.js/React
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache
*.tgz
.yarn-integrity
build/Release
dist/
typings/
jspm_packages/

# ====================================
# 4. インフラ・DevOps
# ====================================

# Docker
.dockerignore
docker-compose.override.yml
.docker/

# Kubernetes
k8s/kustomize-test/
k8s/kind_logs/
k8s/manifests/generated/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan*
.terraform.tfstate.lock.info
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
crash.log
crash.*.log

# ====================================
# 5. CI/CD関連
# ====================================

# GitHub Actions
.github/workflows/secrets/

# 一般的なCI/CD
.ci/
coverage/
test-results/
/junit*.xml

# Jenkins
/_gopath/
/hack/.test-cmd-auth

# Bazel
/bazel-*

# ====================================
# 6. セキュリティ・機密情報
# ====================================

# 環境変数ファイル
.env*
.env/
.envrc

# 機密設定ファイル
**/var.yml
**/secrets.yml

# Cloud Provider設定
/.config/gcloud*/
.gsutil/

# ====================================
# 7. プロジェクト固有
# ====================================

# 内部向け資料
milestone.drawio

# データベース関連
backend/dbvol/data/

# ====================================
# 8. 一時ファイル・ログ
# ====================================

# ログファイル
logs/
*.log

# 一時ファイル
__*
/output*/
_output*/

# ビルド成果物
/third_party/etcd*
/third_party/protoc*
.dockerized-kube-version-defs

# 開発ツール関連
cscope.*
